# Mock mode (default): leave VITE_API_BASE_URL empty.
VITE_API_BASE_URL=

# Local Spring Boot mode: copy this file to .env.local and set:
# VITE_API_BASE_URL=http://localhost:8080

# Deployment surface. Production deployments should use one explicit value:
# PUBLIC   -> public Castro’s website only
# STAFF    -> Castro staff authentication + /app + /owner only
# PLATFORM -> RIGHTWARE Control Plane only
# ALL is reserved for local/integration development.
VITE_APP_SURFACE=ALL

# External navigation target used when staff/platform deployments link back to the public site.
VITE_PUBLIC_SITE_URL=

# Approved high-resolution portrait of Elizabeth Castro.
# Leave empty until Castro’s supplies an original/approved asset; the UI renders an intentional placeholder instead.
VITE_ELIZABETH_PORTRAIT_URL=

# The frontend uses the verified /api/v1 route map from src/api/client/routes.ts.
# Tenant CSRF is obtained from /api/v1/auth/csrf.
# Platform CSRF is obtained independently from /api/v1/platform/auth/csrf.
# Do not add endpoint overrides until the backend contract changes are approved.
